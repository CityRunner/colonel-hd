# Build trees.
/build/

# libFuzzer artifacts written to the working directory by manual runs.
/crash-*
/leak-*
/oom-*
/timeout-*
/out/
compile_commands.json
.cache/
.ccache/

# Game resources are never committed (spec section 2). The patterns are
# case-insensitive because DOS file names may come in either case.
[Rr][Ee][Ss][Oo][Uu][Rr][Cc][Ee].*
[Mm][Ee][Ss][Ss][Aa][Gg][Ee].*
*.[Ss][Cc][Rr]
*.[Hh][Ee][Pp]
*.[Dd][Rr][Vv]
*.[Pp]56
*.[Vv]56
*.[Ss][Cc][Ii]
[Pp][Aa][Tt][Cc][Hh][Ee][Ss]/
# SCI0 patch files hold one resource each: SCRIPT.052, TEXT.052, PATCH.001.
[Vv][Ii][Ee][Ww].[0-9][0-9][0-9]
[Pp][Ii][Cc].[0-9][0-9][0-9]
[Ss][Cc][Rr][Ii][Pp][Tt].[0-9][0-9][0-9]
[Tt][Ee][Xx][Tt].[0-9][0-9][0-9]
[Ss][Oo][Uu][Nn][Dd].[0-9][0-9][0-9]
[Mm][Ee][Mm][Oo][Rr][Yy].[0-9][0-9][0-9]
[Vv][Oo][Cc][Aa][Bb].[0-9][0-9][0-9]
[Ff][Oo][Nn][Tt].[0-9][0-9][0-9]
[Cc][Uu][Rr][Ss][Oo][Rr].[0-9][0-9][0-9]
[Pp][Aa][Tt][Cc][Hh].[0-9][0-9][0-9]

# MT-32 and CM-32L ROM files are never committed.
*.[Rr][Oo][Mm]
*.[Bb][Ii][Nn]

# Images derived from the game art and resource dumps stay local.
/docs/reports/images/
/docs/reports/dumps/

# What the program writes next to itself: its configuration, saved games,
# the analysis cache and the game's own files.
sierra-hd.ini
sierra-hd.toml
*.[Ss][Aa][Vv]
analysis-cache/
/cache/
/files/
/saves/
build.log
__pycache__/
